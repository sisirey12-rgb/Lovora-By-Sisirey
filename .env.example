VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional: your live site URL, used for the social preview image (auto on Vercel)
VITE_SITE_URL=https://your-site.vercel.app

# --- Paid sharing (server-only, set these in Vercel -> Settings -> Environment Variables; never prefix with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=any-long-random-string-you-also-put-in-razorpay
PRICE_INR=99            # launch price; change to 149 when the launch offer ends
REGULAR_PRICE_INR=149   # shown crossed out while PRICE_INR is lower

# Owner accounts that never pay for share links (comma separated emails)
OWNER_EMAILS=you@example.com

# Google sign-in popup (Google Cloud OAuth Web client ID). Makes the popup show your site name and logo instead of supabase.co
VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# AI writing helper, powered by Groq (server-only). Free key at console.groq.com
GROQ_API_KEY=your-groq-key
# optional: GROQ_MODEL=openai/gpt-oss-20b   AI_HOURLY_LIMIT=10

# Landing-page season fallback (server). The owner switch in the account panel overrides it. Values: rakhi, diwali, eid, valentines-day, mothers-day, fathers-day, friendship-day, new-year
ACTIVE_SEASON=

# Optional studio voice for "Read it to me" (server-only). Without it the phone's own voice is used, with natural pauses.
# OPENAI_API_KEY=your-openai-key
# TTS_VOICE=coral   TTS_MODEL=gpt-4o-mini-tts   TTS_HOURLY_LIMIT=30
